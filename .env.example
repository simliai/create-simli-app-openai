# Copy this file to .env.local and fill it in. The web app and the agent both read it.

# From https://cloud.livekit.io (Settings > API keys). A free project works.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# From https://app.simli.com (API key in your profile). Used by the agent.
SIMLI_API_KEY=

# From https://platform.openai.com/api-keys. Used by the agent.
OPENAI_API_KEY=

# Optional: any Trinity-2 face ID and GPT-Live voice. Defaults are in agent/agent.py.
SIMLI_FACE_ID=
OPENAI_VOICE=
