# Copy this file to .env.local and fill in your keys.
# These are read ONLY on the server (app/api/*). Never prefix them with NEXT_PUBLIC_.

# https://app.simli.com -> API key
SIMLI_API_KEY=

# Which avatar to show. Default: Trinity-2 preset "Anna".
# Other presets: https://docs.simli.com/api-reference/preset-faces
SIMLI_FACE_ID=bf13113a-355a-4d97-8b90-4edccd1da7b2

# https://platform.openai.com/settings/organization/api-keys
OPENAI_API_KEY=

# Production safety switch. In production (NODE_ENV=production) the session
# routes refuse with 403 unless this is "true", because as shipped they have no
# authentication and anyone could start sessions billed to you. Add real auth /
# rate limiting first (see README "Before you deploy"); only then, if you still
# rely on this switch, set it to true. Ignored in development.
ALLOW_UNAUTHENTICATED_SESSIONS=false
